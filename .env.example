# PORT: HTTP port for the Express + Vite server (default: 3000)
PORT="3000"

# APP_URL: Public URL where the app is hosted (optional)
APP_URL="http://localhost:3000"

# COMPOSIO_API_KEY: Optional. Enables live Composio toolkit catalog lookup during research.
# Core research pipeline runs independently with no API keys required.
COMPOSIO_API_KEY=""
